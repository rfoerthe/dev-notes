{
  "name": "dev-notes",
  "private": true,
  "version": "1.1.9",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:emulator": "VITE_USE_FIREBASE_EMULATOR=true VITE_FIREBASE_PROJECT_ID=devnotes-local VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099 VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1 VITE_FIRESTORE_EMULATOR_PORT=8080 vite",
    "emulators": "firebase emulators:start --only auth,firestore --project devnotes-local --import .firebase/emulator-data --export-on-exit .firebase/emulator-data",
    "emulator:bootstrap-admin": "FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_PROJECT_ID=devnotes-local node scripts/bootstrap-admin.mjs",
    "emulator:seed": "FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_PROJECT_ID=devnotes-local npm run posts:seed -- --target firestore",
    "emulator:delete-posts": "FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_PROJECT_ID=devnotes-local npm run posts:delete -- --target firestore --yes",
    "emulator:smoke-blog-workflow": "FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_PROJECT_ID=devnotes-local node scripts/smoke-blog-workflow.mjs",
    "build": "tsc -b && vite build",
    "clean": "rimraf --glob dist coverage node_modules/.tmp node_modules/.vite \".firebase/hosting.*.cache\" \"*-debug.log\"",
    "clean:emulator-data": "rimraf .firebase/emulator-data",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy": "npm run build && npm run firebase deploy",
    "preview:deploy": "npm run build && node scripts/deploy-preview.mjs",
    "admin:repair": "node scripts/repair-admin.mjs",
    "restore:admin": "node scripts/repair-admin.mjs",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "user:delete": "node scripts/delete-user.mjs",
    "user:repair": "node scripts/repair-user.mjs",
    "restore:user": "node scripts/repair-user.mjs",
    "posts:delete": "node scripts/delete-posts.mjs",
    "posts:seed": "node scripts/seed-example-posts.mjs",
    "blogs:migrate-workflow": "node scripts/migrate-blog-workflow.mjs",
    "firestore:backup": "node scripts/firestore-backup.mjs",
    "firestore:restore": "node scripts/firestore-restore.mjs",
    "firebase": "firebase",
    "deploy:rules": "node scripts/firebase-cli-project.mjs deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@shikijs/types": "^4.4.3",
    "firebase": "^12.17.1",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.27.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "11.1.1",
    "@opentelemetry/core": "^2.8.0",
    "glob": "^13.0.6",
    "re2": "^1.26.1",
    "node-domexception": "file:./patches/node-domexception"
  },
  "allowScripts": {
    "@firebase/util@1.15.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true,
    "re2@1.26.1": true
  }
}

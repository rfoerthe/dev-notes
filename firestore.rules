rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Checks if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: Checks if the requesting user has the admin role in Firestore
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper: Checks if the requesting user is approved in Firestore
    function isApproved() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    function currentUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function currentUserFullName() {
      return currentUserProfile().firstName + ' ' + currentUserProfile().lastName;
    }

    function validOptionalOperatingSystem() {
      return !request.resource.data.keys().hasAny(['operatingSystem']) ||
        request.resource.data.operatingSystem == null ||
        (request.resource.data.operatingSystem is string && request.resource.data.operatingSystem.size() <= 50);
    }

    function validOptionalBootstrappedAt() {
      return !request.resource.data.keys().hasAny(['bootstrappedAt']) ||
        request.resource.data.bootstrappedAt == resource.data.bootstrappedAt;
    }

    function validUserProfile() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'firstName',
        'lastName',
        'username',
        'email',
        'role',
        'status',
        'createdAt',
        'operatingSystem',
        'bootstrappedAt'
      ]) &&
        request.resource.data.uid is string &&
        request.resource.data.firstName is string && request.resource.data.firstName.size() <= 50 &&
        request.resource.data.lastName is string && request.resource.data.lastName.size() <= 50 &&
        request.resource.data.username is string && request.resource.data.username.size() <= 30 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 100 &&
        request.resource.data.role in ['admin', 'user'] &&
        request.resource.data.status in ['pending', 'approved', 'rejected'] &&
        request.resource.data.createdAt is string &&
        validOptionalOperatingSystem();
    }

    function userIdentityIsImmutable() {
      return request.resource.data.uid == resource.data.uid &&
        request.resource.data.username == resource.data.username &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.createdAt == resource.data.createdAt &&
        validOptionalBootstrappedAt();
    }

    function validBlogPost() {
      return request.resource.data.keys().hasOnly([
        'title',
        'summary',
        'content',
        'tags',
        'authorId',
        'authorName',
        'createdAt',
        'readTime'
      ]) &&
        request.resource.data.title is string && request.resource.data.title.size() <= 150 &&
        request.resource.data.summary is string && request.resource.data.summary.size() <= 300 &&
        request.resource.data.content is string && request.resource.data.content.size() <= 50000 &&
        request.resource.data.tags is list && request.resource.data.tags.size() <= 10 &&
        request.resource.data.readTime is int &&
        request.resource.data.authorId is string &&
        request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100 &&
        request.resource.data.createdAt is string;
    }

    function blogOwnershipIsImmutable() {
      return request.resource.data.authorId == resource.data.authorId &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    // --- Users Collection Rules ---
    match /users/{userId} {
      // Admins can read all profiles. Users can read their own profile.
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Anyone can create their own profile during registration,
      // BUT they must default to 'user' role and 'pending' status!
      allow create: if isAuthenticated() &&
        validUserProfile() &&
        request.auth.uid == userId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == 'user' &&
        request.resource.data.status == 'pending' &&
        !request.resource.data.keys().hasAny(['bootstrappedAt']);
      
      // Admins can update any user's profile.
      // Users can only update their own profile, but CANNOT change their role or status themselves.
      allow update: if isAuthenticated() &&
        validUserProfile() &&
        userIdentityIsImmutable() &&
        (
          (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'status', 'operatingSystem'])) ||
          (
            request.auth.uid == userId &&
            request.resource.data.status == resource.data.status &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'operatingSystem'])
          )
      );
      
      // User deletion must go through the Admin SDK cleanup script so the
      // Firebase Auth account and Firestore profile cannot get out of sync.
      allow delete: if false;
    }

    // --- Public Usernames Collection Rules (PII Protection) ---
    match /usernames/{username} {
      // Anyone can check if a single username document exists (get),
      // but listing/querying the whole collection (list) is forbidden!
      allow get: if true;
      allow list: if false;
      
      // Users can reserve their own username only if it doesn't exist yet
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['uid']) &&
        !exists(/databases/$(database)/documents/usernames/$(username)) &&
        request.resource.data.uid == request.auth.uid;
        
      // Username deletion must go through the Admin SDK cleanup script together
      // with the matching Auth account and user profile.
      allow delete: if false;
    }

    // --- Blogs Collection Rules ---
    match /blogs/{blogId} {
      allow read: if true;
      
      // Enforce strict field-level type safety and size constraints on creation
      allow create: if isApproved() &&
        validBlogPost() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.authorName == currentUserFullName();
      
      // Enforce immutable fields during update
      allow update: if isApproved() &&
        validBlogPost() &&
        blogOwnershipIsImmutable() &&
        (
          (
            resource.data.authorId == request.auth.uid &&
            (
              (
                request.resource.data.authorName == resource.data.authorName &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'summary', 'content', 'tags', 'readTime'])
              ) ||
              (
                request.resource.data.authorName == currentUserFullName() &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorName'])
              )
            )
          ) ||
          (
            isAdmin() &&
            request.resource.data.authorName == resource.data.authorName &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'summary', 'content', 'tags', 'readTime'])
          )
        );
      
      allow delete: if isApproved() && (resource.data.authorId == request.auth.uid || isAdmin());
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Checks if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: Checks if the requesting user has the admin role in Firestore
    function isAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() && exists(userPath) && get(userPath).data.role == 'admin';
    }
    
    // Helper: Checks if the requesting user is approved in Firestore
    function isApproved() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let profile = get(userPath).data;
      return isAuthenticated() &&
        exists(userPath) &&
        profile.status == 'approved' &&
        (
          profile.role == 'admin' ||
          !profile.keys().hasAny(['emailVerified']) ||
          profile.emailVerified == true ||
          request.auth.token.email_verified == true
        );
    }

    function closedUserGroupEnabled() {
      return exists(/databases/$(database)/documents/appSettings/public) &&
        get(/databases/$(database)/documents/appSettings/public).data.closedUserGroupEnabled == true;
    }

    function currentUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function currentUserFullName() {
      return currentUserProfile().firstName + ' ' + currentUserProfile().lastName;
    }

    function validOptionalThemeMode() {
      return !request.resource.data.keys().hasAny(['themeMode']) ||
        request.resource.data.themeMode in ['light', 'dark', 'system'];
    }

    function validOptionalThemeAccent() {
      return !request.resource.data.keys().hasAny(['themeAccent']) ||
        request.resource.data.themeAccent in ['purple', 'blue', 'green', 'rose', 'orange'];
    }

    function validOptionalEmailVerified() {
      return !request.resource.data.keys().hasAny(['emailVerified']) ||
        request.resource.data.emailVerified is bool;
    }

    function validBookmark() {
      return request.resource.data.keys().hasOnly([
        'blogId',
        'title',
        'summary',
        'authorName',
        'authorUsername',
        'tags',
        'readTime',
        'createdAt'
      ]) &&
        request.resource.data.blogId is string &&
        request.resource.data.title is string && request.resource.data.title.size() <= 150 &&
        request.resource.data.summary is string && request.resource.data.summary.size() <= 600 &&
        request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100 &&
        request.resource.data.authorUsername is string &&
        validUsernameValue(request.resource.data.authorUsername) &&
        validTags(true) &&
        request.resource.data.readTime is int &&
        request.resource.data.readTime >= 1 &&
        request.resource.data.readTime <= 240 &&
        request.resource.data.createdAt == request.time;
    }

    function validOptionalBootstrappedAt() {
      return !request.resource.data.keys().hasAny(['bootstrappedAt']) ||
        request.resource.data.bootstrappedAt == resource.data.bootstrappedAt;
    }

    function validUsernameValue(username) {
      return username is string &&
        username.matches('^[a-z0-9][a-z0-9_-]{2,29}$');
    }

    function authEmailMatchesProfile() {
      return request.auth.token.email != null &&
        request.resource.data.email == request.auth.token.email;
    }

    function usernameReservationMatchesCreatedProfile(userId) {
      return existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)) &&
        getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == userId;
    }

    function profileMatchesCreatedUsername(username) {
      return existsAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)) &&
        getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.uid == request.resource.data.uid &&
        getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.username == username &&
        getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.email == request.auth.token.email;
    }

    function validUserProfile() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'firstName',
        'lastName',
        'username',
        'email',
        'role',
        'status',
        'createdAt',
        'emailVerified',
        'themeMode',
        'themeAccent',
        'bootstrappedAt'
      ]) &&
        request.resource.data.uid is string &&
        request.resource.data.firstName is string && request.resource.data.firstName.size() <= 50 &&
        request.resource.data.lastName is string && request.resource.data.lastName.size() <= 50 &&
        validUsernameValue(request.resource.data.username) &&
        request.resource.data.email is string && request.resource.data.email.size() <= 100 &&
        request.resource.data.role in ['admin', 'user'] &&
        request.resource.data.status in ['pending', 'approved', 'rejected'] &&
        request.resource.data.createdAt is string &&
        validOptionalEmailVerified() &&
        validOptionalThemeMode() &&
        validOptionalThemeAccent();
    }

    function validAppSettings() {
      return request.resource.data.keys().hasOnly([
        'closedUserGroupEnabled',
        'updatedAt',
        'updatedBy'
      ]) &&
        request.resource.data.closedUserGroupEnabled is bool &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedBy == request.auth.uid;
    }

    function userIdentityIsImmutable() {
      return request.resource.data.uid == resource.data.uid &&
        request.resource.data.username == resource.data.username &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.createdAt == resource.data.createdAt &&
        validOptionalBootstrappedAt();
    }

    function validTagAt(index) {
      return request.resource.data.tags.size() <= index ||
        request.resource.data.tags[index].matches('^[^<>]{1,40}$');
    }

    function validTags(requireTag) {
      return request.resource.data.tags is list &&
        (!requireTag || request.resource.data.tags.size() > 0) &&
        request.resource.data.tags.size() <= 10 &&
        validTagAt(0) &&
        validTagAt(1) &&
        validTagAt(2) &&
        validTagAt(3) &&
        validTagAt(4) &&
        validTagAt(5) &&
        validTagAt(6) &&
        validTagAt(7) &&
        validTagAt(8) &&
        validTagAt(9);
    }

    function validCreatedAtValue() {
      return request.resource.data.createdAt is timestamp ||
        (
          request.resource.data.createdAt is string &&
          request.resource.data.createdAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$')
        );
    }

    function validBlogPost() {
      return request.resource.data.keys().hasOnly([
        'title',
        'summary',
        'content',
        'tags',
        'authorId',
        'authorName',
        'authorUsername',
        'createdAt',
        'updatedAt',
        'publishedAt',
        'status',
        'readTime'
      ]) &&
        request.resource.data.title is string && request.resource.data.title.size() <= 150 &&
        request.resource.data.summary is string && request.resource.data.summary.size() <= 600 &&
        request.resource.data.content is string && request.resource.data.content.size() <= 200000 &&
        request.resource.data.status in ['draft', 'published'] &&
        validTags(request.resource.data.status == 'published') &&
        (
          request.resource.data.status == 'draft' ||
          (
            request.resource.data.title.size() > 0 &&
            request.resource.data.summary.size() > 0 &&
            request.resource.data.content.size() > 0
          )
        ) &&
        request.resource.data.readTime is int &&
        request.resource.data.readTime >= 1 &&
        request.resource.data.readTime <= 240 &&
        (
          !request.resource.data.keys().hasAny(['authorId']) ||
          request.resource.data.authorId is string
        ) &&
        request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100 &&
        request.resource.data.authorUsername is string &&
        validUsernameValue(request.resource.data.authorUsername) &&
        validCreatedAtValue() &&
        request.resource.data.updatedAt is timestamp &&
        (
          (request.resource.data.status == 'draft' && request.resource.data.publishedAt == null) ||
          (request.resource.data.status == 'published' && request.resource.data.publishedAt is timestamp)
        );
    }

    function blogIdentityIsImmutable() {
      return request.resource.data.keys().hasAny(['authorId']) == resource.data.keys().hasAny(['authorId']) &&
        (
          !resource.data.keys().hasAny(['authorId']) ||
          request.resource.data.authorId == resource.data.authorId
        ) &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function validBlogRevision() {
      return request.resource.data.keys().hasOnly([
        'title', 'summary', 'content', 'tags', 'status', 'savedAt', 'savedBy', 'savedByName'
      ]) &&
        request.resource.data.title is string && request.resource.data.title.size() <= 150 &&
        request.resource.data.summary is string && request.resource.data.summary.size() <= 600 &&
        request.resource.data.content is string && request.resource.data.content.size() <= 200000 &&
        request.resource.data.status in ['draft', 'published'] &&
        request.resource.data.tags is list &&
        request.resource.data.tags.size() <= 10 &&
        request.resource.data.savedAt == request.time &&
        request.resource.data.savedBy == request.auth.uid &&
        request.resource.data.savedByName is string && request.resource.data.savedByName.size() <= 100;
    }

    function validApprovedAuthorTarget(authorUsername, authorName) {
      return exists(/databases/$(database)/documents/usernames/$(authorUsername)) &&
        get(/databases/$(database)/documents/usernames/$(authorUsername)).data.uid is string &&
        exists(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/usernames/$(authorUsername)).data.uid)) &&
        get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/usernames/$(authorUsername)).data.uid)).data.status == 'approved' &&
        get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/usernames/$(authorUsername)).data.uid)).data.username == authorUsername &&
        get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/usernames/$(authorUsername)).data.uid)).data.firstName +
          ' ' +
          get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/usernames/$(authorUsername)).data.uid)).data.lastName == authorName;
    }

    // --- Users Collection Rules ---
    match /users/{userId} {
      // Admins can read all profiles. Users can read their own profile.
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Anyone can create their own profile during registration,
      // BUT they must default to 'user' role and 'pending' status!
      allow create: if isAuthenticated() &&
        validUserProfile() &&
        request.auth.uid == userId &&
        request.resource.data.uid == request.auth.uid &&
        authEmailMatchesProfile() &&
        usernameReservationMatchesCreatedProfile(userId) &&
        request.resource.data.role == 'user' &&
        request.resource.data.status == 'pending' &&
        request.resource.data.emailVerified == false &&
        !request.resource.data.keys().hasAny(['bootstrappedAt']);
      
      // Admins can update any user's profile.
      // Users can only update their own profile, but CANNOT change their role or status themselves.
      allow update: if isAuthenticated() &&
        validUserProfile() &&
        userIdentityIsImmutable() &&
        (
          (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'status', 'operatingSystem', 'themeMode', 'themeAccent'])) ||
          (
            request.auth.uid == userId &&
            request.resource.data.status == resource.data.status &&
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'operatingSystem', 'themeMode', 'themeAccent']) ||
              (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailVerified']) &&
                request.resource.data.emailVerified == true &&
                request.auth.token.email_verified == true
              )
            )
          )
      );
      
      // User deletion must go through the Admin SDK cleanup script so the
      // Firebase Auth account and Firestore profile cannot get out of sync.
      allow delete: if false;

      match /bookmarks/{blogId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;

        allow create: if isApproved() &&
          request.auth.uid == userId &&
          request.resource.data.blogId == blogId &&
          exists(/databases/$(database)/documents/blogs/$(blogId)) &&
          get(/databases/$(database)/documents/blogs/$(blogId)).data.status == 'published' &&
          validBookmark();

        allow update: if false;

        allow delete: if isApproved() && request.auth.uid == userId;
      }

    }

    // --- Public Usernames Collection Rules (PII Protection) ---
    match /usernames/{username} {
      // Anyone can check if a single username document exists (get),
      // but listing/querying the whole collection (list) is forbidden!
      allow get: if true;
      allow list: if false;
      
      // Users can reserve their own username only if it doesn't exist yet
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['uid']) &&
        validUsernameValue(username) &&
        !exists(/databases/$(database)/documents/usernames/$(username)) &&
        request.resource.data.uid == request.auth.uid &&
        profileMatchesCreatedUsername(username);
        
      // Username deletion must go through the Admin SDK cleanup script together
      // with the matching Auth account and user profile.
      allow delete: if false;
    }

    // --- Application Settings Rules ---
    match /appSettings/{settingsId} {
      allow read: if settingsId == 'public';

      allow create, update: if settingsId == 'public' &&
        isAdmin() &&
        validAppSettings() &&
        (
          !exists(/databases/$(database)/documents/appSettings/$(settingsId)) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'closedUserGroupEnabled',
            'updatedAt',
            'updatedBy'
          ])
        );

      allow delete: if false;
    }

    // --- Blogs Collection Rules ---
    match /blogs/{blogId} {
      allow read: if (
        resource.data.status == 'published' && (!closedUserGroupEnabled() || isApproved())
      ) || (
        isApproved() && (isAdmin() || resource.data.authorUsername == currentUserProfile().username)
      );
      
      // Enforce strict field-level type safety and size constraints on creation
      allow create: if isApproved() &&
        validBlogPost() &&
        !request.resource.data.keys().hasAny(['authorId']) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        (
          (request.resource.data.status == 'draft' && request.resource.data.publishedAt == null) ||
          (request.resource.data.status == 'published' && request.resource.data.publishedAt == request.time)
        ) &&
        request.resource.data.authorName == currentUserFullName() &&
        request.resource.data.authorUsername == currentUserProfile().username;
      
      // Enforce immutable fields during update
      allow update: if isApproved() &&
        validBlogPost() &&
        blogIdentityIsImmutable() &&
        request.resource.data.updatedAt == request.time &&
        (
          (request.resource.data.status == 'draft' && request.resource.data.publishedAt == null) ||
          (
            request.resource.data.status == 'published' &&
            (
              request.resource.data.publishedAt == resource.data.publishedAt ||
              (resource.data.status == 'draft' && request.resource.data.publishedAt == request.time)
            )
          )
        ) &&
        (
          (
            resource.data.authorUsername == currentUserProfile().username &&
            request.resource.data.authorUsername == resource.data.authorUsername &&
            (
              (
                request.resource.data.authorName == resource.data.authorName &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'summary', 'content', 'tags', 'readTime', 'status', 'updatedAt', 'publishedAt'])
              ) ||
              (
                request.resource.data.authorName == currentUserFullName() &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorName', 'updatedAt'])
              )
            )
          ) ||
          (
            isAdmin() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'summary', 'content', 'tags', 'readTime', 'status', 'updatedAt', 'publishedAt', 'authorName', 'authorUsername']) &&
            (
              (
                request.resource.data.authorUsername == resource.data.authorUsername &&
                request.resource.data.authorName == resource.data.authorName
              ) ||
              validApprovedAuthorTarget(request.resource.data.authorUsername, request.resource.data.authorName)
            )
          )
        );
      
      allow delete: if isApproved() && (resource.data.authorUsername == currentUserProfile().username || isAdmin());

      match /revisions/{revisionId} {
        allow read, delete: if isApproved() &&
          (isAdmin() || get(/databases/$(database)/documents/blogs/$(blogId)).data.authorUsername == currentUserProfile().username);
        allow create: if isApproved() &&
          (isAdmin() || get(/databases/$(database)/documents/blogs/$(blogId)).data.authorUsername == currentUserProfile().username) &&
          validBlogRevision();
        allow update: if false;
      }
    }
  }
}
